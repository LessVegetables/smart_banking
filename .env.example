DATABASE_URL=sqlite:///./data/alfa.db
DEMO_MODE=true
STAFF_PASSWORD=replace-with-a-long-random-password
# Docker Compose only: the PostgreSQL password (letters, digits and hyphens).
POSTGRES_PASSWORD=replace-with-a-postgres-password
# Python log level of the API and the worker: DEBUG, INFO, WARNING.
LOG_LEVEL=INFO
TELEGRAM_BOT_TOKEN=
COOKIE_SECURE=false
APP_ORIGIN=http://127.0.0.1:5173
# Optional OpenAI-compatible LLM server (vLLM, Ollama, llama.cpp). Empty LLM_BASE_URL keeps the template assistant.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Mock sources and the synthetic world they play (apps/sources/README.md). Empty uses the default.
MOCK_SOURCES_LATENCY_SCALE=
MOCK_SOURCES_FAILURES=
MOCK_SOURCES_HANG_SECONDS=
# MOCK: the source_down demo persona (apps/world/PERSONAS.md) gets a bureau error. Empty plays every source normally.
MOCK_SOURCES_SCENARIOS={"2309002984": {"bki": "error"}}
WORLD_DIR=
WORLD_SEED=
WORLD_N=
WORLD_AS_OF=
# Enrichment (apps/sources/README.md): timeout per attempt, attempts in all, pause between attempts. Empty uses the default.
SOURCE_TIMEOUT_SECONDS=
SOURCE_ATTEMPTS=
SOURCE_RETRY_BACKOFF_SECONDS=
# Scoring (apps/api/SCORING.md): scorecard paths from the repo root. Empty uses scorecard_v1 / scorecard_v0; SCORECARD_CHALLENGER=none turns shadow mode off.
SCORECARD_CHAMPION=
SCORECARD_CHALLENGER=
